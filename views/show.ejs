<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= blog.title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1><%= blog.title %></h1>
    <p><%= blog.body %></p>
    <div>
        <a href="/">Back to Home</a> |
        <a href="/blogs/<%= blog.id %>/edit">Edit</a> |
        <a href="/blogs/<%= blog.id %>/delete">Delete</a>
    </div>

    <hr>
    
    <h2>Comments</h2>
    <div id="comments-container">
        <p>Loading comments...</p>
    </div>
    
    <h3>Add a Comment</h3>
    <form action="/comments/blog/<%= blog.id %>" method="POST">
      <textarea name="content" required placeholder="Write your comment here..."></textarea>
      <br>
      <button type="submit">Post Comment</button>
    </form>
    
    <script>
        // Fetch and display comments
        document.addEventListener('DOMContentLoaded', () => {
            const commentsContainer = document.getElementById('comments-container');
            
            fetch(`/api/comments/blog/<%= blog.id %>`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(comments => {
                    if (comments.length === 0) {
                        commentsContainer.innerHTML = '<p>No comments yet. Be the first to comment!</p>';
                        return;
                    }
                    
                    const commentsHTML = comments.map(comment => `
                        <div class="comment">
                            <p>${comment.content}</p>
                            <div class="comment-actions">
                                <a href="/comments/${comment.id}/edit">Edit</a> |
                                <a href="/comments/${comment.id}/delete">Delete</a>
                            </div>
                        </div>
                        <hr>
                    `).join('');
                    
                    commentsContainer.innerHTML = commentsHTML;
                })
                .catch(error => {
                    console.error('Error fetching comments:', error);
                    commentsContainer.innerHTML = 
                        `<p>Error loading comments: ${error.message}. Please try again later.</p>`;
                });
        });
    </script>
</body>
</html>
